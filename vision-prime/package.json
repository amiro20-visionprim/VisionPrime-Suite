{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint resources/js --max-warnings=0",
    "lint:fix": "eslint resources/js --fix",
    "format": "prettier --write \"resources/**/*.{css,js,ts,vue,json}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"resources/**/*.{css,js,ts,vue,json}\" \"*.{js,ts,json}\"",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inertiajs/vue3": "^3.6.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/jalaali-js": "^1.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "axios": "^1.11.0",
    "concurrently": "^9.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "laravel-vite-plugin": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.7",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@lucide/vue": "^1.26.0",
    "jalaali-js": "^2.0.0",
    "vazirmatn": "^33.0.3"
  }
}
